          "headers": {
            "x-ig-app-id": "936619743392459",
            "x-csrftoken": {
              "cookie": "csrftoken"
            }
          }
        },
        {
          "key": "home",
          "url": "https://www.instagram.com/",
          "parse": "text",
          "reuse": 720
        },
        {
          "key": "dm",
          "url": "https://www.instagram.com/api/graphql",
          "parse": "json",
          "origin": "https://www.instagram.com",
          "headers": {
            "x-ig-app-id": "936619743392459",
            "x-csrftoken": {
              "cookie": "csrftoken"
            },
            "x-fb-lsd": {
              "from": "home",
              "regex": "\"LSD\",\\[\\],\\{\"token\":\"([^\"]+)\""
            },
            "x-fb-friendly-name": "IGDBadgeCountOffMsysQuery"
          },
          "form": {
            "fb_dtsg": {
              "from": "home",
              "regex": "\"DTSGInitialData\",\\[\\],\\{\"token\":\"([^\"]+)\""
            },
            "lsd": {
              "from": "home",
              "regex": "\"LSD\",\\[\\],\\{\"token\":\"([^\"]+)\""
            },
            "fb_api_caller_class": "RelayModern",
            "fb_api_req_friendly_name": "IGDBadgeCountOffMsysQuery",
            "server_timestamps": "true",
            "doc_id": "28939180542359933",
            "variables": {
              "uuid": true,
              "template": "{\"device_id_for_iris_subscription\":\"{value}\",\"__relay_internal__pv__IGDMetaAIThreadingEnabledGKrelayprovider\":false}"
            }
          }
        }
      ],
      "label": {
        "from": "me",
        "json": "form_data.username"
      },
      "map": {
        "dm": {
          "from": "dm",
          "unreadChats": "data.get_slide_mailbox_for_iris_subscription"
        },
        "reply": {
          "from": "inbox",
          "json": ["counts.comments", "counts.usertags", "counts.story_mentions", "counts.photos_of_you"],
          "zero": true
        },
        "react": {
          "from": "inbox",
          "json": ["counts.likes", "counts.comment_likes"],
          "zero": true
        },
        "follow": {
          "from": "inbox",
          "json": ["counts.relationships", "counts.requests"],
          "zero": true
        }
      },
      "errorIf": {
        "from": "dm",
        "json": "errors"
      }
    },
