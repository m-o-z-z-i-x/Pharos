{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Run dev mode (Chrome)",
      "cwd": "${workspaceFolder}",
      "command": "npm run dev"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Run dev mode (Firefox)",
      "cwd": "${workspaceFolder}",
      "command": "npm run dev:firefox"
    }
  ]
}